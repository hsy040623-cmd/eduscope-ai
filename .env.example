# EduScope AI 환경변수 예시 — 이 파일을 .env 로 복사해 값을 채웁니다. (.env 는 git에 올리지 않습니다)
# 아래 3개는 서버 코드에서만 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요. (브라우저로 노출됩니다)

# OpenAI API 키 (AI 항목 정리·차이 분석)
OPENAI_API_KEY=

# Supabase 프로젝트 주소와 anon(공개) 키 — Supabase 대시보드 > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── 관리용 값 (앱 실행에는 필요 없고, 배포·DB 작업을 도구로 할 때만 로컬에서 씁니다. 배포 서버에는 등록하지 않습니다) ──
# GITHUB_TOKEN=
# SUPABASE_ACCESS_TOKEN=
# VERCEL_TOKEN=
